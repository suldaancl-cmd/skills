# OSINT skill — maximum-depth API keys
# 1. Copy this file to "keys.env" in the same folder.
# 2. Paste your real key after each "=" (no quotes, no spaces).
# 3. Claude sources keys.env before running any osint script.
# Free tiers are noted. Leave a line blank to skip that service.

# ===== TIER 1 — biggest depth jump, get these first =====

# Perplexity — Sonar + Deep Research (AI answers with citations). ~$5/mo.
#   https://www.perplexity.ai/settings/api
export PERPLEXITY_API_KEY=

# Apify — 55+ social scrapers (Instagram/Facebook/TikTok/YouTube/LinkedIn). ~$5/mo free credit.
#   https://console.apify.com/account/integrations
export APIFY_API_TOKEN=

# ===== TIER 2 — strong, mostly free =====

# Jina AI — URL->markdown reader + deepsearch. Free tier.
#   https://jina.ai/api-key
export JINA_API_KEY=

# Tavily — agent-optimized search. Free tier, then $0.005/request.
#   https://app.tavily.com/home
export TAVILY_API_KEY=

# Parallel AI — AI search + extract with citations. Free tier.
#   https://platform.parallel.ai
export PARALLEL_API_KEY=

# Exa — semantic people/company search (also already available via MCP). ~$5/mo.
#   https://dashboard.exa.ai
export EXA_API_KEY=

# ===== TIER 3 — deepest, paid; public data behind soft walls only =====

# Bright Data — Facebook public scraping, Yandex, geo proxying. ~$10/mo+.
#   https://brightdata.com/products/web-scraper/mcp
export BRIGHTDATA_MCP_URL=
